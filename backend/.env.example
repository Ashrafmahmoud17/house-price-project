# Copy this file to .env and adjust as needed.

APP_NAME="House Price Prediction API"

# Path to the exported pipeline (relative to where uvicorn is started, i.e. backend/)
MODEL_PATH=models/house_price.pkl

# Path to the location list exported by the notebook, used to map unknown/rare
# locations to "other" at inference time (relative to backend/)
LOCATIONS_PATH=../frontend/src/locations.json

# Comma-separated list is not supported by default pydantic-settings list parsing from .env;
# override via JSON array syntax if you need multiple origins, e.g.:
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.example.com"]
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
